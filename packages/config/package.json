{
  "name": "@wlbp/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "instance-brand.d.ts",
    "instance-brand.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./instance-brand": {
      "types": "./instance-brand.d.ts",
      "import": "./instance-brand.mjs",
      "default": "./instance-brand.mjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "wlbp": {
    "distribution": "distributed"
  }
}
