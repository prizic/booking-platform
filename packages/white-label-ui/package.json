{
  "name": "@wlbp/white-label-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brand-config": {
      "types": "./dist/brand-config.d.ts",
      "import": "./dist/brand-config.js"
    },
    "./instance-content": {
      "types": "./dist/instance-content.d.ts",
      "import": "./dist/instance-content.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@wlbp/ui-foundation": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "wlbp": {
    "distribution": "distributed"
  }
}
