# Optional: set only when your trusted reverse proxy strips/overwrites this
# header with the real client IP. Allowed: x-forwarded-for, x-real-ip,
# x-vercel-forwarded-for. Unset uses a restrictive shared backend abuse bucket.
WLBP_TRUSTED_CLIENT_IP_HEADER=
