        { "type": "url", "value": "/contact$" },
        { "type": "text", "selector": "h1", "value": "تواصل معنا" },
        {
          "type": "visible",
          "selector": "main a[href=\"mailto:hello@tenant-a.example.invalid\"]"
        },
        { "type": "hidden", "selector": "div[data-slot=\"empty-state\"]" }
      ]
    }
  ]
